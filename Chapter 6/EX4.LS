       0000          FIELD 0
       0200          *0200           /PAGE 1
             /
             / GOAL: READ A BLOCK FROM PTR INTO MEMORY
             / THIS PROGRAM WILL BE CAPABLE OF READING IN A LARGE BLOCK
             / OF TEXT FROM THE PAPER TAPE READER LEVERAGING THE HIGH
             / SPEED PAPER TAPE READER INSTRUCTIONS.  THE INPUT DATA
             / WILL BE STORED IN DATA FIELD 1, STARTING AT ADDRESS 0200.

             / THIS WILL YIELD A MAXIMUM INPUT BLOCK SIZE OF 3968 WORDS.

             / THE INPUT BLOCK WILL BE EXPECTED TO BE ASCII TEXT AND
             / TERMINATED WITH A '$' ON ITS OWN LINE.  THE INPUT TEXT
             / MUST BE IN "DOS" FORMAT WITH CRLF LINE TERMINATION, NOT
             / CR LINE TERMINATION.

00200  6211          CDF     10
00201  4215          JMS     CLRBFR
00202  4223          JMS     RDPTR
00203  7402          HLT
00204  5777'         JMP     OS8RET

             /LOCINI
             /INITIALIZE LOCATION RELATED VALUES
             /ENTRY: BLKINI  STARTING ADDRESS OF LOCATION -1
             /EXIT:  CURLOC  AUTOINDEX POINTER TO FIRST LOCATION -1
             /       COUNTR  LOOP COUNTER SET TO FIRST LOCATION
00205  0000  LOCINI, 0
00206  7300          CLA CLL
00207  1200          TAD     BLKINI  /INIT COUNTER AT START OF MEM BLOCK

00210  3010          DCA     CURLOC
00211  1200          TAD     BLKINI  /INIT LOOP COUNTER
00212  7001          IAC             /HANDLE FIRST INCREMENT
00213  3201          DCA     COUNTR
00214  5605          JMP I   LOCINI

             /CLRBFR
             /INITIALIZE MEMORY DEPOSIT LOCATIONS
             /ENTRY: COUNTR  LOOP COUNTER TRACKING CURRENT INDEX
             /       CURLOC  AUTOINDEX POINTER TO THE CURRENT ADDRESS
             /EXIT:  MEMORY ADDRESSES FROM BLKINI TO 7777 SET TO 0000
00215  0000  CLRBFR, 0
00216  4205          JMS     LOCINI  /INITIALIZE POINTERS AND COUNTERS
00217  3410  CLRTOP, DCA I   CURLOC  /STORE 0000 IN THE CURRENT ADDRESS
00220  2201          ISZ     COUNTR  /KEEP TRACK OF WHERE WE ARE
00221  5217          JMP     CLRTOP  /REPEAT IF NOT DONE
00222  5615          JMP I   CLRBFR  /RETURN IF DONE

             /RDPTR
             /READ A BLOCK OF TEXT IN FROM HIGH SPEET PAPER TAPE READER
             /ENTRY: COUNTR  LOOP COUNTER TRACKING CURRENT INDEX
             /       CURLOC  AUTOINDEXPOINTER TO THE CURRENT ADDRESS
             /EXIT:  CURCHR  THE MOST RECENT CHARACTER READ
             /       A MEMORY BLOCK STARTING AT BFRINI THAT CONTAINS THE

             /        DATA READ IN FROM THE PAPER TAPE READER
             /       THE BLOCK OF DATA READ IN IS OUTPUT TO THE TTY
00223  0000  RDPTR,  0
00224  4205          JMS     LOCINI
00225  6014  RDTOP,  RFC             /READ CHAR FROM PTR
00226  6011  CKFLG,  RSF
00227  5226          JMP     CKFLG
00230  7200          CLA
00231  6012          RRB             /READ FROM PTR BUFFER
00232  3020          DCA     CURCHR  /STORE FOR PROCESSING
00233  4247          JMS     NRMCHR  /NORMALIZE TO HANDLE LOWERCASE
00234  4265          JMS     CKEOF   /LOOK FOR EOF SEQUENCE
00235  1021          TAD     EOFFND  /RETURN IF EOF FOUND
00236  7440          SZA
00237  5623          JMP I   RDPTR
00240  2201          ISZ     COUNTR  /CHECK IF WE HAVE FILLED MEMORY
00241  5243          JMP     STRCHR  /IF NOT STORE READ CHARACTER
00242  5623          JMP I   RDPTR   /RETURN IF SO
00243  4776' STRCHR, JMS     PRTCHR  /PRINT CHARACTER TO TTY
00244  1020          TAD     CURCHR
00245  3410          DCA I   CURLOC  /STORE IN MEMORY
00246  5225          JMP     RDTOP

             /NRMCHR
             /NORMALIZE CHARACTER TO UPPER CASE
             /ENTRY: CURCHR  CHARACTER TO NORMALIZE
             /EXIT:  CURCHR  LOWERCASE ASCII CHARACTER
00247  0000  NRMCHR, 0
00250  1375          TAD     (0141)  /ASCII LOWERCASE "A"
00251  1374          TAD     (0200)  /OFFSET TO DEC CHARACTER CODES
00252  7041          CIA
00253  1020          TAD     CURCHR
00254  7510          SPA             /POSITIVE AC -> LOWERCASE LETTER
00255  5647          JMP I   NRMCHR  /NOTHING TO DO
00256  7200          CLA
00257  1373          TAD     (0040)  /32.  OFFSET BETWEEN CAPS & LOWER
00260  7041          CIA
00261  1020          TAD     CURCHR
00262  3020          DCA     CURCHR  /LETTERS SHOULD BE CAPS NOW
00263  5647          JMP I   NRMCHR  /RETURN

00264  5665  CKEOFR, JMP I   CKEOF   /TRAMPOLINE BACK TO CKEOF CALLER

             /CKEOF
             /DETECT EOF COMBINATION OF CR, LF, $, CR, LF
             /ENTRY: CURCHR  CURRENT INPUT CHARACTER
             /       EOFCTR  NEGATIVE VALUE OF HOW MANY CHARACTERS IN
             /                THE STRING HAVE BEEN FOUND
             /       FNDDLR  BOOL IF $ HAS BEEN FOUND IN THE RIGHT SPOT
             /EXIT:  FNDDLR
             /       EOFFND  BOOL IF EOF STRING HAS BEEN FOUND
00265  0000  CKEOF,  0
00266  7200          CLA
00267  1020          TAD     CURCHR
00270  0372          AND     (0177)
00271  7041          CIA
00272  1371          TAD     (0015)  /CHECK FOR CR
00273  7450          SNA
00274  5313          JMP     CRFND
00275  7200          CLA
00276  1020          TAD     CURCHR
00277  0372          AND     (0177)
00300  7041          CIA
00301  1370          TAD     (0012)  /CHECK FOR LF
00302  7450          SNA
00303  5331          JMP     LFFND
00304  7200          CLA
00305  1020          TAD     CURCHR
00306  0372          AND     (0177)
00307  7041          CIA
00310  1367          TAD     (0044)  /CHECK FOR $
00311  7450          SNA
00312  5766'         JMP     DLRFND
00313  7200  CRFND,  CLA             /STORE IF FIRST CHAR OR 4TH W/$
00314  1022          TAD     EOFCTR  /CHECK IF FIRST CHAR
00315  1365          TAD     (5)
00316  7450          SNA
00317  5764'         JMP     NOEOF
00320  7200          CLA
00321  1023          TAD     FNDDLR  /IF $ HASNT BEEN SEEN YET, NOT EOF
00322  7450          SNA
00323  5763'         JMP     EOFRST
00324  7200          CLA
00325  1022          TAD     EOFCTR
00326  1362          TAD     (2)     /IF 4TH CHAR
00327  7450          SNA
00330  5764'         JMP     NOEOF
00331  7200  LFFND,  CLA
00332  1022          TAD     EOFCTR
00333  1361          TAD     (4)
00334  7450          SNA
00335  5764'         JMP     NOEOF
00336  7200          CLA
00337  1023          TAD     FNDDLR
00340  7450          SNA
00341  5763'         JMP     EOFRST
00342  7200          CLA
00343  1022          TAD     EOFCTR
00344  7001          IAC
00345  7450          SNA
00346  5760'         JMP     YESEOF

00360  0416
00361  0004
00362  0002
00363  0421
00364  0410
00365  0005
00366  0400
00367  0044
00370  0012
00371  0015
00372  0177
00373  0040
00374  0200
00375  0141
00376  0427
00377  0437
       0400          *0400           /PAGE 2
00400  7200  DLRFND, CLA
00401  1022          TAD     EOFCTR
00402  1377          TAD     (3)
00403  7440          SZA
00404  5221          JMP     EOFRST
00405  7201          CLA IAC
00406  3023          DCA     FNDDLR
00407  5210          JMP     NOEOF
00410  7200  NOEOF,  CLA
00411  3021          DCA     EOFFND
00412  1022          TAD     EOFCTR
00413  7001          IAC
00414  3022          DCA     EOFCTR
00415  5776'         JMP     CKEOFR
00416  7201  YESEOF, CLA IAC
00417  3021          DCA     EOFFND
00420  5776'         JMP     CKEOFR
00421  7200  EOFRST, CLA
00422  1375          TAD     (7773)
00423  3022          DCA     EOFCTR
00424  3021          DCA     EOFFND
00425  3023          DCA     FNDDLR
00426  5776'         JMP     CKEOFR

             /PRINT CHARACTER TO TTY
00427  0000  PRTCHR, 0
00430  7200          CLA
00431  1020          TAD     CURCHR
00432  6046          TLS
00433  7200          CLA
00434  6041  WAIT,   TSF
00435  5234          JMP     WAIT    /VERIFY DEVICE HAS COMPLETED OUTPUT

00436  5627          JMP I   PRTCHR

00437  6203  OS8RET, CIF CDF 0
00440  5774          JMP I   (7600)

             /DATA VALUES

             /AUTOINDEX REGISTERS
00574  7600
00575  7773
00576  0264
00577  0003
       0010  *0010
00010  0000  CURLOC, 0

             /PAGE 0 VALUES
       0020  *0020
00020  0000  CURCHR, 0
00021  0000  EOFFND, 0
00022  7773  EOFCTR, 7773    /-5.
00023  0000  FNDDLR, 0

             /PAGE 1 VALUES
       0200  *0200
00200  0577  BLKINI, 0577
00201  0000  COUNTR, 0

             $


BLKINI 0200
CKEOF  0265
