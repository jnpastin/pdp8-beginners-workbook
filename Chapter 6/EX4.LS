       0000          FIELD 0
       0200          *0200           /PAGE 1
             /
             / GOAL: READ A BLOCK FROM PTR INTO MEMORY
             / THIS PROGRAM WILL BE CAPABLE OF READING IN A LARGE BLOCK
             / OF TEXT FROM THE PAPER TAPE READER LEVERAGING THE HIGH
             / SPEED PAPER TAPE READER INSTRUCTIONS.  THE INPUT DATA
             / WILL BE STORED IN DATA FIELD 1, STARTING AT ADDRESS 0200.

             / THIS WILL YIELD A MAXIMUM INPUT BLOCK SIZE OF 3968 WORDS.

             / THE INPUT BLOCK WILL BE EXPECTED TO BE ASCII TEXT AND
             / TERMINATED WITH A '$' ON ITS OWN LINE.  THE INPUT TEXT
             / MUST BE IN "DOS" FORMAT WITH CRLF LINE TERMINATION, NOT
             / CR LINE TERMINATION.

00200  6211          CDF     10
00201  4214          JMS     CLRBFR
00202  4222          JMS     RDPTR
00203  5777'         JMP     OS8RET

             /LOCINI
             /INITIALIZE LOCATION RELATED VALUES
             /ENTRY: BLKINI  STARTING ADDRESS OF LOCATION -1
             /EXIT:  CURLOC  AUTOINDEX POINTER TO FIRST LOCATION -1
             /       COUNTR  LOOP COUNTER SET TO FIRST LOCATION
00204  0000  LOCINI, 0
00205  7300          CLA CLL
00206  1350          TAD     BLKINI  /INIT COUNTER AT START OF MEM BLOCK

00207  3010          DCA     CURLOC
00210  1350          TAD     BLKINI  /INIT LOOP COUNTER
00211  7001          IAC             /HANDLE FIRST INCREMENT
00212  3351          DCA     COUNTR
00213  5604          JMP I   LOCINI

             /CLRBFR
             /INITIALIZE MEMORY DEPOSIT LOCATIONS
             /ENTRY: COUNTR  LOOP COUNTER TRACKING CURRENT INDEX
             /       CURLOC  AUTOINDEX POINTER TO THE CURRENT ADDRESS
             /EXIT:  MEMORY ADDRESSES FROM BLKINI TO 7777 SET TO 0000
             /                       IN FIELD 1
00214  0000  CLRBFR, 0
00215  4204          JMS     LOCINI  /INITIALIZE POINTERS AND COUNTERS
00216  3410  CLRTOP, DCA I   CURLOC  /STORE 0000 IN THE CURRENT ADDRESS
00217  2351          ISZ     COUNTR  /KEEP TRACK OF WHERE WE ARE
00220  5216          JMP     CLRTOP  /REPEAT IF NOT DONE
00221  5614          JMP I   CLRBFR  /RETURN IF DONE

             /RDPTR
             /READ A BLOCK OF TEXT IN FROM HIGH SPEED PAPER TAPE READER
             /ENTRY: COUNTR  LOOP COUNTER TRACKING CURRENT INDEX
             /       CURLOC  AUTOINDEX POINTER TO THE CURRENT ADDRESS
             /EXIT:  CURCHR  THE MOST RECENT CHARACTER READ
             /       A MEMORY BLOCK STARTING AT BLKINI THAT CONTAINS THE

             /        DATA READ IN FROM THE PAPER TAPE READER
             /       THE BLOCK OF DATA READ IN IS OUTPUT TO THE TTY
00222  0000  RDPTR,  0
00223  4204          JMS     LOCINI
00224  6014  RDTOP,  RFC             /READ CHAR FROM PTR
00225  6011  CKFLG,  RSF
00226  5225          JMP     CKFLG
00227  7200          CLA
00230  6012          RRB             /READ FROM PTR BUFFER
00231  3020          DCA     CURCHR  /STORE FOR PROCESSING
00232  4245          JMS     NRMCHR  /NORMALIZE TO HANDLE LOWERCASE
00233  4263          JMS     CKEOF   /LOOK FOR EOF SEQUENCE
00234  1021          TAD     EOFFND  /RETURN IF EOF FOUND
00235  7440          SZA
00236  5622          JMP I   RDPTR
00237  4776'         JMS     PRTCHR  /PRINT CHARACTER TO TTY
00240  1020          TAD     CURCHR
00241  3410          DCA I   CURLOC  /STORE IN MEMORY
00242  2351          ISZ     COUNTR  /CHECK IF WE HAVE FILLED MEMORY
00243  5224          JMP     RDTOP   /IF NOT STORE READ CHARACTER
00244  5622          JMP I   RDPTR   /RETURN IF SO

             /NRMCHR
             /NORMALIZE CHARACTER TO UPPER CASE
             /ENTRY: CURCHR  CHARACTER TO NORMALIZE
             /EXIT:  CURCHR  UPPERCASE ASCII CHARACTER
00245  0000  NRMCHR, 0
00246  1375          TAD     (0141)  /ASCII LOWERCASE "A"
00247  1374          TAD     (0200)  /OFFSET TO DEC CHARACTER CODES
00250  7041          CIA
00251  1020          TAD     CURCHR
00252  7510          SPA             /POSITIVE AC -> LOWERCASE LETTER
00253  5645          JMP I   NRMCHR  /NOTHING TO DO
00254  7200          CLA
00255  1373          TAD     (0040)  /32.  OFFSET BETWEEN CAPS & LOWER
00256  7041          CIA
00257  1020          TAD     CURCHR
00260  3020          DCA     CURCHR  /LETTERS SHOULD BE CAPS NOW
00261  5645          JMP I   NRMCHR  /RETURN

00262  5663  CKEOFR, JMP I   CKEOF   /TRAMPOLINE BACK TO CKEOF CALLER

             /CKEOF
             /DETECT EOF COMBINATION OF CR, LF, $, CR, LF
             /ENTRY: CURCHR  CURRENT INPUT CHARACTER
             /       EOFCTR  NEGATIVE VALUE OF HOW MANY CHARACTERS IN
             /                THE STRING HAVE BEEN FOUND
             /       FNDDLR  BOOL IF $ HAS BEEN FOUND IN THE RIGHT SPOT
             /EXIT:  FNDDLR
             /       EOFFND  BOOL IF EOF STRING HAS BEEN FOUND
00263  0000  CKEOF,  0
00264  7200          CLA
00265  1020          TAD     CURCHR
00266  0372          AND     (0177)
00267  7041          CIA
00270  1371          TAD     (0015)  /CHECK FOR CR
00271  7450          SNA
00272  5312          JMP     CRFND
00273  7200          CLA
00274  1020          TAD     CURCHR
00275  0372          AND     (0177)
00276  7041          CIA
00277  1370          TAD     (0012)  /CHECK FOR LF
00300  7450          SNA
00301  5330          JMP     LFFND
00302  7200          CLA
00303  1020          TAD     CURCHR
00304  0372          AND     (0177)
00305  7041          CIA
00306  1367          TAD     (0044)  /CHECK FOR $
00307  7450          SNA
00310  5766'         JMP     DLRFND
00311  5765'         JMP     EOFRST  /RESET EOF IF NO SENTINELS FOUND
00312  7200  CRFND,  CLA             /STORE IF FIRST CHAR OR 4TH W/$
00313  1022          TAD     EOFCTR  /CHECK IF FIRST CHAR
00314  1364          TAD     (5)
00315  7450          SNA
00316  5763'         JMP     NOEOF
00317  7200          CLA
00320  1023          TAD     FNDDLR  /IF $ HASNT BEEN SEEN YET, NOT EOF
00321  7450          SNA
00322  5765'         JMP     EOFRST
00323  7200          CLA
00324  1022          TAD     EOFCTR
00325  1362          TAD     (2)     /IF 4TH CHAR
00326  7450          SNA
00327  5763'         JMP     NOEOF
00330  7200  LFFND,  CLA
00331  1022          TAD     EOFCTR
00332  1361          TAD     (4)
00333  7450          SNA
00334  5763'         JMP     NOEOF
00335  7200          CLA
00336  1023          TAD     FNDDLR
00337  7450          SNA
00340  5765'         JMP     EOFRST
00341  7200          CLA
00342  1022          TAD     EOFCTR
00343  7001          IAC
00344  7450          SNA
00345  5760'         JMP     YESEOF

00360  0416
00361  0004
00362  0002
00363  0410
00364  0005
00365  0421
00366  0400
00367  0044
00370  0012
00371  0015
00372  0177
00373  0040
00374  0200
00375  0141
00376  0427
00377  0437
       0400          *0400           /PAGE 2
00400  7200  DLRFND, CLA
00401  1022          TAD     EOFCTR
00402  1377          TAD     (3)
00403  7440          SZA
00404  5221          JMP     EOFRST
00405  7201          CLA IAC
00406  3023          DCA     FNDDLR
00407  5210          JMP     NOEOF
00410  7200  NOEOF,  CLA
00411  3021          DCA     EOFFND
00412  1022          TAD     EOFCTR
00413  7001          IAC
00414  3022          DCA     EOFCTR
00415  5776'         JMP     CKEOFR
00416  7201  YESEOF, CLA IAC
00417  3021          DCA     EOFFND
00420  5776'         JMP     CKEOFR
00421  7200  EOFRST, CLA
00422  1375          TAD     (7773)
00423  3022          DCA     EOFCTR
00424  3021          DCA     EOFFND
00425  3023          DCA     FNDDLR
00426  5776'         JMP     CKEOFR

             /PRINT CHARACTER TO TTY
00427  0000  PRTCHR, 0
00430  7200          CLA
00431  1020          TAD     CURCHR
00432  6046          TLS
00433  7200          CLA
00434  6041  WAIT,   TSF
00435  5234          JMP     WAIT    /VERIFY DEVICE HAS COMPLETED OUTPUT

00436  5627          JMP I   PRTCHR

00437  7402  OS8RET, HLT
00440  6203          CIF CDF 0
00441  5774          JMP I   (7600)

             /DATA VALUES

             /AUTOINDEX REGISTERS
00574  7600
00575  7773
00576  0262
00577  0003
       0010  *0010
00010  0000  CURLOC, 0

             /PAGE 0 VALUES
       0020  *0020
00020  0000  CURCHR, 0
00021  0000  EOFFND, 0
00022  7773  EOFCTR, 7773    /-5.
00023  0000  FNDDLR, 0

             /PAGE 1 VALUES
       0350  *0350
00350  0177  BLKINI, 0177
00351  0000  COUNTR, 0

