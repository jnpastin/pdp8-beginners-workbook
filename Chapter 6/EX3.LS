             / GOAL: LINEB^QBUFFERED INPUT ROUTINE
             / IMPLEMENTED AS A FIXED LENGTH (72 CHARS) BUFFER THAT
             / TERMINATES INPUT WHEN A CR IS DETECTED OR WHEN THE
             / BUFFER FILLS UP.  TEXT IS NORMALIZED TO UPPERCASE AS IT
             / IS READ.  ONCE THE INPUT HAS COMPLETED, THE ENTIRE LINE
             / IS OUTPUT TO THE TTY

             /INIT
             /READ CHARACTER
             /VALIDATE CHARACTER
             /STORE CHARACTER
             /READ NEXT CHARACTER
             /PRINT ENTIRE LINE
             /REPEAT


00200  4334  TOP,    JMS     PRTMSG  /PRINT THE PROMPT
00201  4210          JMS     CLRBFR  /ENSURE THE BUFFER IS CLEAN
00202  7200          CLA
00203  1020          TAD     BFRINI
00204  3010          DCA     BFRPTR  /INITIALIZE THE POINTER
00205  4225          JMS     GETBFR  /READ IN THE LINE BUFFER
00206  4271          JMS     PRTBFR  /PRINT THE LINE BUFFER
00207  5200          JMP     TOP

             /CLRBFR
             /CLEAR THE BUFFER, POPULATING EVERY WORD WITH 0000
             /ENTRY: BFRPTR  THE OFFSET FROM THE START OF THE BUFFER
             /               THAT THE CURRENT CHARACTER RESIDES AT
             /       BFRLEN  THE LENGTH OF THE BUFFER (NEG VALUE)
             /       BFRINI  ADDRESS THAT THE BUFFER BEGINS AT
             /EXIT:  CURCHR  SCRATCH VALUE ADDRESS OF CURRENT LOCATION
             /       ALL ADDRESSES FROM BFRINI TO BFRINI - BFRLEN -> 0

00210  0000  CLRBFR, 0
00211  7300          CLA CLL
00212  1020          TAD     BFRINI
00213  3010          DCA     BFRPTR  /RESET THE BUFFER POINTER
00214  1020  CLRTOP, TAD     BFRINI
00215  7041          CIA
00216  1021          TAD     BFRLEN  /THIS IS ALREADY NEGATIVE
00217  1010          TAD     BFRPTR  /SEE IF BUFFER IS FULL
00220  7450          SNA
00221  5610          JMP I   CLRBFR  /RETURN FROM SUBROUTINE
00222  7200          CLA
00223  3410          DCA I   BFRPTR  /STORE 0 IN THE CHARACTER
00224  5214          JMP     CLRTOP  /RETURN TO TOP OF LOOP

             /GETBFR
             /READ IN A CHARACTER FROM THE KEYBOARD, NORMALIZE IT TO
             /UPPER CASE, STORE IT IN THE BUFFER, ADVANCE THE POINTER
             /TO THE NEXT LOCATION IN THE BUFFER.  REPEAT UNTIL A CR IS
             /DETECTED OR THE BUFFER IS FULL
             /ENTRY: BFRPTR  POINTER TO THE CURRENT ADDRESS IN THE BUFFE
R
             /       BFRINI  STARTING ADDRESS OF THE BUFFER
             /       BFRLEN  LENGTH OF THE BUFFER
             /EXIT:  <BUFFER> AN ARRAY OF CHARACTERS TO BE OUTPUT
00225  0000  GETBFR, 0
00226  7300          CLA CLL
00227  3022          DCA     CURCHR
00230  6036          KRB             /CONSUME THE CR FROM LOAD /G
00231  6031  CKINFL, KSF
00232  5231          JMP     CKINFL  /WAIT FOR THE KEYBOARD FLAG
00233  6036          KRB
00234  3022          DCA     CURCHR
00235  1377          TAD     (0141)  /ASCII LOWERCASE "A"
00236  1376          TAD     (0200)  /OFFSET TO DEC CHARACTER CODES
00237  7041          CIA
00240  1022          TAD     CURCHR
00241  7510          SPA             /POSITIVE AC -> LOWERCASE LETTER
00242  5250          JMP     UCASE
00243  7200          CLA
00244  1375          TAD     (0040)  /32.  OFFSET BETWEEN CAPS & LOWER
00245  7041          CIA
00246  1022          TAD     CURCHR
00247  3022          DCA     CURCHR  /LETTERS SHOULD BE CAPS NOW
00250  7300  UCASE,  CLA CLL
00251  1374          TAD     (0215)  /TEST TO SEE IF CHARACTER WAS CR
00252  7041          CIA
00253  1022          TAD     CURCHR
00254  7450          SNA             /IF IT WAS, RETURN FROM SUBROUTINE
00255  5625          JMP I   GETBFR
00256  7300          CLA CLL         /TEST TO SEE IF BUFFER IS FULL
00257  1020          TAD     BFRINI  /SUBTRACT STARTING LOCATION FROM
00260  7041          CIA             /POINTER
00261  1010          TAD     BFRPTR
00262  1021          TAD     BFRLEN  /COMPARE WITH LENGTH
00263  7450          SNA
00264  5625          JMP I   GETBFR  /IF FULL, RETURN FROM SUBROUTINE
00265  7300          CLA CLL
00266  1022          TAD     CURCHR
00267  3410          DCA I   BFRPTR  /STORE THE CHARACTER IN THE BUFFER
00270  5231          JMP     CKINFL  /GET MORE INPUT

             /PRTBFR
             /PRINT THE BUFFER TO THE TTY
             /ENTRY: BFRPTR  A POINTER TO THE TOP ADDRESS OF THE BUFFER
             /       BFRINI  THE STARTING ADDRESS OF THE BUFFER -1
             /       <BUFFER> AN ARRAY OF CHARACTERS TO BE OUTPUT
             /                STARTING AT BFRINI WITH LENGTH =
             /                BFRPTR-BFRINI
             /EXIT:  BUFFER IS PRINTED TO TTY
00271  0000  PRTBFR, 0
00272  7300          CLA CLL
00273  1010          TAD     BFRPTR  /LOOK FOR AN EMPTY STRING
00274  7041          CIA
00275  1020          TAD     BFRINI
00276  7450          SNA
00277  5364          JMP     OS8RET  /RETURN TO OS/8 IF FOUND
00300  7200          CLA
00301  1010          TAD     BFRPTR  /FROM THE LAST POPULATED INDEX
00302  3023          DCA     PRTEND  /STORE AS END OF ACTIVE BUFFER
00303  1020          TAD     BFRINI
00304  3010          DCA     BFRPTR  /RESET THE POINTER TO THE START
00305  7200  BFROUT, CLA
00306  1410          TAD I   BFRPTR  /GET THE CURRENT CHARACTER
00307  6046          TLS             /PRINT IT TO TTY
00310  7200          CLA
00311  6041  CKOUTF, TSF
00312  5311          JMP     CKOUTF  /VERIFY DEVICE HAS COMPLETED OUTPUT

00313  1010          TAD     BFRPTR  /CHECK IF THERE IS STILL MORE DATA
00314  7041          CIA
00315  1023          TAD     PRTEND
00316  7550          SPA SNA
00317  5321          JMP     PRTXIT
00320  5305          JMP     BFROUT
00321  7200  PRTXIT, CLA
00322  1373          TAD     (0015)  /PRINT CR
00323  6046          TLS
00324  6041  CKCRF,  TSF
00325  5324          JMP     CKCRF
00326  7200          CLA
00327  1372          TAD     (0012)  /PRINT LF
00330  6046          TLS
00331  6041  CKLFF,  TSF
00332  5331          JMP     CKLFF
00333  5671          JMP I   PRTBFR

             /PRTMSG
             /PRINTS THE PROMPT TO THE TTY
             /ENTRY: MESG    A 0 TERMINATED ARRAY WITH THE PROMPT
             /EXIT:  PROMPT IS PRINTED TO TTY
00334  0000  PRTMSG, 0
00335  7300          CLA CLL
00336  1771'         TAD     MESG    /LOAD THE START OF THE MESSAGE
00337  3011          DCA     MSGCHR  /WILL INCREMENT TO FIRST CHAR
00340  5343          JMP     FRSTCH  /FIRST CHARACTER JUST GETS DUMPED
00341  6041  MSGOUT, TSF             /CHECK IF THE FLAG IS SET
00342  5341          JMP     MSGOUT  /GETS SKIPPED IF THE FLAG IS SET
00343  1411  FRSTCH, TAD I   MSGCHR
00344  7450          SNA             /CHECK FOR SENTINEL
00345  5351          JMP     MSGXIT
00346  6046          TLS             /SEND CHAR, CLEAR FLAG
00347  7200          CLA             /CLEAR THE AC AFTER PRINTING
00350  5341          JMP     MSGOUT
00351  7200  MSGXIT, CLA
00352  1373          TAD     (0015)  /PRINT CR
00353  6046          TLS
00354  6041  CKCRF2, TSF
00355  5354          JMP     CKCRF2
00356  7200          CLA
00357  1372          TAD     (0012)  /PRINT LF
00360  6046          TLS
00361  6041  CKLFF2, TSF
00362  5361          JMP     CKLFF2
00363  5734          JMP I   PRTMSG

00364  7300  OS8RET, CLA CLL
00365  6203          CIF CDF 0
00366  5770          JMP     I       (7600)

