        FIELD 0
        *0200		/PAGE 1
/
/ GOAL: LINE‑BUFFERED INPUT ROUTINE
/ IMPLEMENTED AS A FIXED LENGTH (72 CHARS) BUFFER THAT 
/ TERMINATES INPUT WHEN A CR IS DETECTED OR WHEN THE
/ BUFFER FILLS UP.  TEXT IS NORMALIZED TO UPPERCASE AS IT
/ IS READ.  ONCE THE INPUT HAS COMPLETED, THE ENTIRE LINE
/ IS OUTPUT TO THE TTY

/INIT
/READ CHARACTER
/VALIDATE CHARACTER
/STORE CHARACTER
/READ NEXT CHARACTER
/PRINT ENTIRE LINE
/REPEAT


TOP,	JMS 	PRTMSG	/PRINT THE PROMPT
	JMS	CLRBFR	/ENSURE THE BUFFER IS CLEAN
	CLA
	TAD	BFRINI
	DCA	BFRPTR	/INITIALIZE THE POINTER
	JMS	GETBFR	/READ IN THE LINE BUFFER
	JMS 	PRTBFR	/PRINT THE LINE BUFFER
	JMP	TOP
	
/CLRBFR
/CLEAR THE BUFFER, POPULATING EVERY WORD WITH 0000
/ENTRY:	BFRPTR	THE OFFSET FROM THE START OF THE BUFFER 
/		THAT THE CURRENT CHARACTER RESIDES AT
/	BFRLEN	THE LENGTH OF THE BUFFER (NEG VALUE)
/	BFRINI	ADDRESS THAT THE BUFFER BEGINS AT
/EXIT:	CURCHR	SCRATCH VALUE ADDRESS OF CURRENT LOCATION
/	ALL ADDRESSES FROM BFRINI TO BFRINI - BFRLEN -> 0	
CLRBFR,	0
	CLA CLL
	TAD	BFRINI
	DCA	BFRPTR	/RESET THE BUFFER POINTER
CLRTOP,	TAD	BFRINI
	CIA
	TAD	BFRLEN	/THIS IS ALREADY NEGATIVE
	TAD	BFRPTR	/SEE IF BUFFER IS FULL
	SNA
	JMP I	CLRBFR	/RETURN FROM SUBROUTINE
	CLA
	DCA I	BFRPTR	/STORE 0 IN THE CHARACTER
	JMP	CLRTOP	/RETURN TO TOP OF LOOP

/GETBFR
/READ IN A CHARACTER FROM THE KEYBOARD, NORMALIZE IT TO
/UPPER CASE, STORE IT IN THE BUFFER, ADVANCE THE POINTER
/TO THE NEXT LOCATION IN THE BUFFER.  REPEAT UNTIL A CR IS
/DETECTED OR THE BUFFER IS FULL
/ENTRY:	BFRPTR	POINTER TO THE CURRENT ADDRESS IN THE BUFFER
/	BFRINI	STARTING ADDRESS OF THE BUFFER
/	BFRLEN	LENGTH OF THE BUFFER
/EXIT:	<BUFFER> AN ARRAY OF CHARACTERS TO BE OUTPUT
GETBFR,	0
	CLA CLL
	DCA	CURCHR
	KRB		/CONSUME THE CR FROM `LOAD /G`
CKINFL,	KSF
	JMP	CKINFL	/WAIT FOR THE KEYBOARD FLAG
	KRB
	DCA	CURCHR
	TAD	(0141)	/ASCII LOWERCASE "A"
	TAD	(0200)	/OFFSET TO DEC CHARACTER CODES
	CIA
	TAD 	CURCHR
	SPA		/POSITIVE AC -> LOWERCASE LETTER
	JMP	UCASE
	CLA
	TAD	(0040)	/32.  OFFSET BETWEEN CAPS & LOWER
	CIA
	TAD 	CURCHR
	DCA 	CURCHR	/LETTERS SHOULD BE CAPS NOW
UCASE,	CLA CLL
	TAD	(0215)	/TEST TO SEE IF CHARACTER WAS CR
	CIA
	TAD	CURCHR
	SNA		/IF IT WAS, RETURN FROM SUBROUTINE
	JMP I	GETBFR
	CLA CLL
	TAD	CURCHR
	DCA I	BFRPTR	/STORE THE CHARACTER IN THE BUFFER
	CLA CLL		/TEST TO SEE IF BUFFER IS FULL
	TAD	BFRINI	/SUBTRACT STARTING LOCATION FROM
	CIA		/POINTER
	TAD	BFRPTR	
	TAD	BFRLEN	/COMPARE WITH LENGTH
	SNA
	JMP I	GETBFR	/IF FULL, RETURN FROM SUBROUTINE
	JMP	CKINFL	/GET MORE INPUT
	
/PRTBFR
/PRINT THE BUFFER TO THE TTY
/ENTRY:	BFRPTR	A POINTER TO THE TOP ADDRESS OF THE BUFFER
/	BFRINI	THE STARTING ADDRESS OF THE BUFFER -1
/	<BUFFER> AN ARRAY OF CHARACTERS TO BE OUTPUT 
/		 STARTING AT BFRINI WITH LENGTH =
/		 BFRPTR-BFRINI
/EXIT:	BUFFER IS PRINTED TO TTY
PRTBFR,	0
	CLA CLL
	TAD	BFRPTR	/LOOK FOR AN EMPTY STRING
	CIA
	TAD	BFRINI
	SNA
	JMP	OS8RET	/RETURN TO OS/8 IF FOUND
	CLA
	TAD	BFRPTR	/FROM THE LAST POPULATED INDEX
	DCA	PRTEND	/STORE AS END OF ACTIVE BUFFER
	TAD	BFRINI
	DCA	BFRPTR	/RESET THE POINTER TO THE START
BFROUT,	CLA
	TAD I	BFRPTR	/GET THE CURRENT CHARACTER
	TLS		/PRINT IT TO TTY
	CLA
CKOUTF,	TSF
	JMP	CKOUTF	/VERIFY DEVICE HAS COMPLETED OUTPUT
	TAD	BFRPTR	/CHECK IF THERE IS STILL MORE DATA
	CIA
	TAD	PRTEND
	SPA SNA
	JMP	PRTXIT
	JMP	BFROUT
PRTXIT, CLA
	TAD	(0015)	/PRINT CR
	TLS
CKCRF,	TSF
	JMP	CKCRF
	CLA
	TAD	(0012)	/PRINT LF
	TLS
CKLFF,	TSF
	JMP	CKLFF
	JMP I	PRTBFR

/PRTMSG
/PRINTS THE PROMPT TO THE TTY
/ENTRY:	MESG	A 0 TERMINATED ARRAY WITH THE PROMPT
/EXIT:	PROMPT IS PRINTED TO TTY	
PRTMSG,	0
	CLA CLL
	TAD	MESG	/LOAD THE START OF THE MESSAGE
	DCA	MSGCHR	/WILL INCREMENT TO FIRST CHAR 
	JMP	FRSTCH	/FIRST CHARACTER JUST GETS DUMPED
MSGOUT,	TSF		/CHECK IF THE FLAG IS SET
	JMP	MSGOUT	/GETS SKIPPED IF THE FLAG IS SET
FRSTCH,	TAD I	MSGCHR
	SNA		/CHECK FOR SENTINEL
	JMP 	MSGXIT
	TLS		/SEND CHAR, CLEAR FLAG
	CLA		/CLEAR THE AC AFTER PRINTING
	JMP	MSGOUT
MSGXIT,	CLA
	TAD	(0015)	/PRINT CR
	TLS
CKCRF2,	TSF
	JMP	CKCRF2
	CLA
	TAD	(0012)	/PRINT LF
	TLS
CKLFF2,	TSF
	JMP	CKLFF2
	JMP I	PRTMSG
	
OS8RET,	CLA CLL
	CIF CDF	0
	JMP	I	(7600)

/DATA VALUES
	*0010		/AUTO-INDEX REGISTERS
BFRPTR,	0
MSGCHR,	0

	*0020		/VALUES IN PG 0, PG 1 SPACE TIGHT
BFRINI,	0377		/STARTING ADDRESS OF BUFFER
BFRLEN,	7601		/-127. LENGTH OF THE BUFFER
CURCHR,	0		/POINTER TO THE CURRENT CHARACTER
PRTEND, 0		/INDEX IN BUFFER TO STOP PRINTING

	*0600		/PAGE 3 VALUES (MESSAGE)
MESG,	.
	"E
	"N
	"T
	"E
	"R
	" 
	"A
	" 
	"L
	"I
	"N
	"E
	" 
	"F
	"O
	"L
	"L
	"W
	"E
	"D
	" 
	"B
	"Y
	" 
	"C
	"R
	" 
	"(
	"E
	"M
	"P
	"T
	"Y
	" 
	"L
	"I
	"N
	"E
	" 
	"T
	"O
	" 
	"Q
	"U
	"I
	"T
	")
	":
	0 
