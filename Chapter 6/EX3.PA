/ PDP-8 WORKBOOK
/ CHAPTER 6
/ EXERCISE 3
/ PAL8 ASSEMBLY
/ JEREMY PASTIN
/ VERSION 1.0 MAY 187, 2026
/
        FIELD 0
        *0200
/
/ GOAL: LINE‑BUFFERED INPUT ROUTINE
/ IMPLEMENTED AS A FIXED LENGTH (72 CHARS) BUFFER THAT 
/ TERMINATES INPUT WHEN A CR IS DETECTED OR WHEN THE
/ BUFFER FILLS UP.  TEXT IS NORMALIZED TO UPPERCASE AS IT
/ IS READ.  ONCE THE INPUT HAS COMPLETED, THE ENTIRE LINE
/ IS OUTPUT TO THE TTY

/INIT
/READ CHARACTER
/VALIDATE CHARACTER
/STORE CHARACTER
/READ NEXT CHARACTER
/PRINT ENTIRE LINE
/REPEAT


	JMS	CLRBFR	/ENSURE THE BUFFER IS CLEAN
	JMS	GETCHR

/CLRBFR
/CLEAR THE BUFFER, POPULATING EVERY WORD WITH 0000
/ENTRY:	BFRPTR	THE OFFSET FROM THE START OF THE BUFFER 
/		THAT THE CURRENT CHARACTER RESIDES AT
/	BFRLEN	THE LENGTH OF THE BUFFER (NEG VALUE)
/	BFRINI	ADDRESS THAT THE BUFFER BEGINS AT
/EXIT:	CURCHR	SCRATCH VALUE ADDRESS OF CURRENT LOCATION
/	ALL ADDRESSES FROM BFRINI TO BFRINI - BFRLEN -> 0	
CLRBFR,	0
CLRTOP,	CLA CLL
	TAD I	BFRPTR
	DCA	CURCHR	/GET ADDRESS OF CURRENT CHARACTER
	TAD	BFRLEN
	TAD	CURCHR	/SEE IF BUFFER IS FULL
	SNA
	JMP I	CLRBFR	/RETURN FROM SUBROUTINE
	CLA
	TAD	CURCHR
	TAD	BFRINI
	DCA	CURCHR	/OFFSET BY STARTING POINT
	DCA I	CURCHR	/STORE 0 IN THE CHARACTER
	JMP	CLRTOP	/RETURN TO TOP OF LOOP

GETCHR,	0
CHRIN,	CLA CLL
	KSF
	JMP	CHRIN	/WAIT FOR THE KEYBOARD FLAG
	KRB
	DCA	CURCHR
	JMS	VALCHR
	
/VALCHR
/VALIDATE INPUT ON A CHAR, THEN OUTPUT IT TO TTY  
/	1) CONVERT LOWERCASE TO UPPERCASE
/	2) CHECK FOR Q TO ESCAPE
/ENTRY:	CHAR	ASCII CODE FOR THE CHARACTER TO VALIDATE
/EXIT:	CHAR	NORMALIZED ASCII CHARACTER
VALCHR,	0
	TAD	(0141)	/ASCII LOWERCASE "A"
	TAD	(0200)	/OFFSET TO DEC CHARACTER CODES
	CIA
	TAD I	CURCHR
	SPA		/POSITIVE AC -> LOWERCASE LETTER
	JMP	UCASE
	CLA
	TAD	(0040)	/32.  OFFSET BETWEEN CAPS & LOWER
	CIA
	TAD I	CURCHR
	DCA I	CURCHR	/LETTERS SHOULD BE CAPS NOW
UCASE,	CLA CLL
	TAD	(0215)	/TEST TO SEE IF CHARACTER WAS CR
	CIA
	TAD	CHAR
	SNA		/IF IT WAS JUMP BACK TO OS/8
	JMP	OS8RET
//////	JMS	CHROUT
	JMP I	VALCHR
	
/DATA VALUES
	*0010
CHRPTR,	0		
	*0200
BFRINI,	0400
BFRLEN,	7601		/-127. LENGTH OF THE BUFFER
CURCHR,	0

	*0400
