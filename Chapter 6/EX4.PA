/
/ PDP-8 WORKBOOK
/ CHAPTER 6
/ EXERCISE 4
/ PAL8 ASSEMBLY
/ JEREMY PASTIN
/ VERSION 1.0 MAY 22, 2026
/
        FIELD 0
        *0200		/PAGE 1
/
/ GOAL: READ A BLOCK FROM PTR INTO MEMORY
/ THIS PROGRAM WILL BE CAPABLE OF READING IN A LARGE BLOCK
/ OF TEXT FROM THE PAPER TAPE READER LEVERAGING THE HIGH
/ SPEED PAPER TAPE READER INSTRUCTIONS.  THE INPUT DATA 
/ WILL BE STORED IN DATA FIELD 1, STARTING AT ADDRESS 0200.
/ THIS WILL YIELD A MAXIMUM INPUT BLOCK SIZE OF 3968 WORDS.
/ THE INPUT BLOCK WILL BE EXPECTED TO BE ASCII TEXT AND 
/ TERMINATED WITH A '$' ON ITS OWN LINE.  THE INPUT TEXT
/ MUST BE IN "DOS" FORMAT WITH CRLF LINE TERMINATION, NOT
/ CR LINE TERMINATION.

	CDF	10
	JMS	CLRBFR
	JMS	EOFINI
	JMS	RDPTR
	HLT
	
/LOCINI
/INITIALIZE LOCATION RELATED VALUES
/ENTRY:	BLKINI	STARTING ADDRESS OF LOCATION -1
/EXIT:	CURLOC	AUTOINDEX POINTER TO FIRST LOCATION -1
/	COUNTR	LOOP COUNTER SET TO FIRST LOCATION
LOCINI,	0
	CLA CLL
	TAD	BLKINI	/INIT COUNTER AT START OF MEM BLOCK
	DCA	CURLOC
	TAD	BLKINI	/INIT LOOP COUNTER
	IAC		/HANDLE FIRST INCREMENT
	DCA	COUNTR
	JMP I	LOCINI

/CLRBFR
/INITIALIZE MEMORY DEPOSIT LOCATIONS
/ENTRY:	COUNTR	LOOP COUNTER TRACKING CURRENT INDEX
/	CURLOC	AUTOINDEX POINTER TO THE CURRENT ADDRESS
/EXIT:	MEMORY ADDRESSES FROM BLKINI TO 7777 SET TO 0000
CLRBFR,	0
	JMS	LOCINI	/INITIALIZE POINTERS AND COUNTERS
CLRTOP,	DCA I	CURLOC	/STORE 0000 IN THE CURRENT ADDRESS
	ISZ	COUNTR	/KEEP TRACK OF WHERE WE ARE
	JMP	CLRTOP	/REPEAT IF NOT DONE
	JMP I	CLRBFR	/RETURN IF DONE
	
/RDPTR
/READ A BLOCK OF TEXT IN FROM HIGH SPEET PAPER TAPE READER
/ENTRY:	COUNTR	LOOP COUNTER TRACKING CURRENT INDEX
/	CURLOC	AUTOINDEXPOINTER TO THE CURRENT ADDRESS
/EXIT:	CURCHR	THE MOST RECENT CHARACTER READ
/	A MEMORY BLOCK STARTING AT BFRINI THAT CONTAINS THE
/	 DATA READ IN FROM THE PAPER TAPE READER
/	THE BLOCK OF DATA READ IN IS OUTPUT TO THE TTY
RDPTR,	0
	JMS	LOCINI
RDTOP,	RFC		/READ CHAR FROM PTR
CKFLG,	RSF
	JMP	CKFLG
	CLA
	RRB		/READ FROM PTR BUFFER
	DCA	CURCHR	/STORE FOR PROCESSING
	JMS	NRMCHR	/NORMALIZE TO HANDLE LOWERCASE
	JMS	CKEOF	/LOOK FOR EOF SEQUENCE
	TAD	EOFFND	/RETURN IF EOF FOUND
	SZA
	JMP I	RDPTR
	ISZ	COUNTR	/CHECK IF WE HAVE FILLED MEMORY
	JMP	STRCHR	/IF NOT STORE READ CHARACTER
	JMP I	RDPTR	/RETURN IF SO
STRCHR,	JMS	PRTCHR	/PRINT CHARACTER TO TTY
	TAD	CURCHR
	DCA I	CURLOC	/STORE IN MEMORY
	JMP	RDTOP

/NRMCHR
/NORMALIZE CHARACTER TO UPPER CASE
/ENTRY:	CURCHR	CHARACTER TO NORMALIZE
/EXIT:	CURCHR	LOWERCASE ASCII CHARACTER
NRMCHR,	0
	TAD	(0141)	/ASCII LOWERCASE "A"
	TAD	(0200)	/OFFSET TO DEC CHARACTER CODES
	CIA
	TAD 	CURCHR
	SPA		/POSITIVE AC -> LOWERCASE LETTER
	JMP I	NRMCHR	/NOTHING TO DO
	CLA
	TAD	(0040)	/32.  OFFSET BETWEEN CAPS & LOWER
	CIA
	TAD 	CURCHR
	DCA 	CURCHR	/LETTERS SHOULD BE CAPS NOW
	JMP I	NRMCHR	/RETURN

CKEOFR,	JMP I	CKEOF	/TRAMPOLINE BACK TO CKEOF CALLER

/CKEOF	
/DETECT EOF COMBINATION OF CR, LF, $, CR, LF
/ENTRY:	CURCHR	CURRENT INPUT CHARACTER
/	EOFCTR	NEGATIVE VALUE OF HOW MANY CHARACTERS IN
/		 THE STRING HAVE BEEN FOUND
/	FNDDLR	BOOL IF $ HAS BEEN FOUND IN THE RIGHT SPOT
/EXIT:	FNDDLR
/	EOFFND	BOOL IF EOF STRING HAS BEEN FOUND
CKEOF,	0
	CLA
	TAD	CURCHR
	AND	(0177)
	CIA
	TAD	(0015)	/CHECK FOR CR
	SNA
	JMP	CRFND
	CLA
	TAD	CURCHR
	AND	(0177)
	CIA
	TAD	(0012)	/CHECK FOR LF
	SNA
	JMP	LFFND
	CLA
	TAD	CURCHR
	AND	(0177)
	CIA
	TAD	(0044)	/CHECK FOR $
	SNA
	JMP	DLRFND
CRFND,	CLA		/STORE IF FIRST CHAR OR 4TH W/$
	TAD	EOFCTR	/CHECK IF FIRST CHAR
	TAD	(5)
	SNA
	JMP	NOEOF
	CLA
	TAD	FNDDLR	/IF $ HASNT BEEN SEEN YET, NOT EOF
	SNA
	JMP	EOFRST
	CLA
	TAD	EOFCTR
	TAD	(2)	/IF 4TH CHAR
	SNA
	JMP	NOEOF
LFFND,	CLA
	TAD	EOFCTR
	TAD	(4)
	SNA
	JMP	NOEOF
	CLA
	TAD	FNDDLR
	SNA
	JMP	EOFRST
	CLA
	TAD	EOFCTR
	IAC
	SNA
	JMP	YESEOF

	*0400		/PAGE 2
DLRFND,	CLA
	TAD	EOFCTR
	TAD	(3)
	SZA
	JMP	EOFRST
	CLA IAC
	DCA	FNDDLR
	JMP	NOEOF
NOEOF,	CLA
	DCA	EOFFND
	TAD	EOFCTR
	IAC
	DCA	EOFCTR
	JMP I	CKEOFR
YESEOF,	CLA IAC
	DCA	EOFFND
	JMP I	CKEOFR
EOFRST,	CLA
	TAD	(7773)
	DCA	EOFCTR
	DCA	EOFFND
	DCA	FNDDLR
	JMP I	CKEOFR
	
/PRINT CHARACTER TO TTY
PRTCHR,	0
	CLA
	TAD	CURCHR
	TLS
	CLA
WAIT,	TSF
	JMP	WAIT	/VERIFY DEVICE HAS COMPLETED OUTPUT
	JMP I	PRTCHR


/DATA VALUES

/AUTOINDEX REGISTERS
*0010
CURLOC,	0

/PAGE 0 VALUES
*0020
CURCHR,	0
EOFFND,	0
EOFCTR,	7773	/-5.
DLRFND,	0

/PAGE 1 VALUES
*0200
BLKINI,	0177
COUNTR,	0

$
